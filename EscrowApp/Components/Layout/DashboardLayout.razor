@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components

<div class="dash-shell">

    @* ── Sidebar ─────────────────────────────────────────────── *@
    <aside class="dash-sidebar">
        <div class="sidebar-brand">
            <svg class="brand-icon" xmlns="http://www.w3.org/2000/svg" width="26" height="26"
                 viewBox="0 0 16 16" fill="url(#sbGrad)" aria-hidden="true">
                <defs>
                    <linearGradient id="sbGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="var(--accent-blue)" />
                        <stop offset="100%" stop-color="var(--accent-magenta)" />
                    </linearGradient>
                </defs>
                <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5z"/>
            </svg>
            <span class="brand-name text-gradient">NexTruzt.io</span>
        </div>

        <nav class="sidebar-nav" aria-label="Dashboard navigation">
            <a class="sidebar-link @ActiveClass("dashboard")" href="@DashboardHref">
                <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                <span>Overview</span>
            </a>
            <a class="sidebar-link @ActiveClass("transaction")" href="@DashboardHref">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                <span>Transactions</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <a class="sidebar-link" href="/">
                <i class="bi bi-house" aria-hidden="true"></i>
                <span>Home</span>
            </a>
            <form method="post" action="/auth/logout" class="w-100">
                <AntiforgeryToken />
                <button type="submit" class="sidebar-link sidebar-logout w-100 text-start border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
                    <span>Sign Out</span>
                </button>
            </form>
        </div>
    </aside>

    @* ── Main content area ───────────────────────────────────── *@
    <div class="dash-main">

        @* Top bar *@
        <header class="dash-topbar">
            <div class="topbar-title">
                <CascadingAuthenticationState>
                    <AuthorizeView>
                        <Authorized>
                            <span class="topbar-greeting">
                                <i class="bi bi-person-circle me-2 opacity-50"></i>@context.User.Identity?.Name
                            </span>
                        </Authorized>
                    </AuthorizeView>
                </CascadingAuthenticationState>
            </div>
            <div class="topbar-actions">
                <span class="badge-env">MVP</span>
            </div>
        </header>

        @* Page body *@
        <main class="dash-body">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
