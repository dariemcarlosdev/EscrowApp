@* SocialProof — Trust badges and early-adopter statistics *@

<div class="container py-5">
    <div class="row text-center mb-4" data-reveal>
        <p class="text-secondary text-uppercase fw-bold small ls-wide">
            @L["Title"]
        </p>
    </div>

    <div class="row g-4 justify-content-center" data-reveal-stagger>
        <div class="col-6 col-md-3">
            <div class="glass-panel text-center py-4 px-3 stat-card">
                <div class="display-6 fw-bold stat-value mb-1">256-bit</div>
                <p class="text-secondary small mb-0">@L["AesEncryption"]</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-panel text-center py-4 px-3 stat-card">
                <div class="display-6 fw-bold stat-value mb-1">100%</div>
                <p class="text-secondary small mb-0">@L["FraudProtection"]</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-panel text-center py-4 px-3 stat-card">
                <div class="display-6 fw-bold stat-value mb-1">24/7</div>
                <p class="text-secondary small mb-0">@L["FundMonitoring"]</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-panel text-center py-4 px-3 stat-card">
                <div class="display-6 fw-bold stat-value mb-1">PCI</div>
                <p class="text-secondary small mb-0">@L["DssCompliant"]</p>
            </div>
        </div>
    </div>
</div>
