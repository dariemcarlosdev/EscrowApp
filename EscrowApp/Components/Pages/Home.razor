@page "/"
@rendermode InteractiveServer

<PageTitle>@L["PageTitle"]</PageTitle>

<a class="visually-hidden-focusable skip-link" href="#main-content">
    @L["SkipToContent"]
</a>

<div class="page-container w-100 min-vh-100 position-relative">
    <NavBar />

    <div class="bg-blob blob-1" aria-hidden="true"></div>
    <div class="bg-blob blob-2" aria-hidden="true"></div>

    <main id="main-content">
        @* Reveal/stagger choreography lives inside each section on meaningful
           elements (headers vs. card groups). Hero is above the fold and owns
           its own CSS entrance, so it is intentionally not scroll-revealed. *@
        <HeroSection />
        <HowItWorks />
        <SocialProof />
        <FaqSection />
    </main>

    <Footer />
</div>
