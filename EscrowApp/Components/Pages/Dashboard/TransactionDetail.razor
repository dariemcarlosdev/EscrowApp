@page "/dashboard/transaction/{TransactionId:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [StreamRendering]
@using Microsoft.Extensions.Localization

<div class="container mt-4">
    @if (_isLoading)
    {
        <div class="dash-loader">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@L["Loading"]</span>
            </div>
        </div>
    }
    else if (_notFound)
    {
        <div class="alert alert-warning">
            <h4 class="alert-heading">@L["NotFound"]</h4>
            <p>@L["TransactionNotFoundMessage"]</p>
        </div>
    }
    else
    {
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/dashboard/client">@L["Dashboard"]</a></li>
                <li class="breadcrumb-item active">@L["TransactionDetail"] #@TransactionId</li>
            </ol>
        </nav>

        <div class="dash-panel mb-4">
            <div class="dash-panel-header">
                <span class="panel-title">@L["TransactionDetail"] #@TransactionId</span>
            </div>
            <div class="dash-panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">@L["Client"]</dt>
                            <dd class="col-sm-8">--</dd>
                            <dt class="col-sm-4">@L["Consultant"]</dt>
                            <dd class="col-sm-8">--</dd>
                            <dt class="col-sm-4">@L["Amount"]</dt>
                            <dd class="col-sm-8 txn-amount">$--</dd>
                            <dt class="col-sm-4">@L["Status"]</dt>
                            <dd class="col-sm-8"><span class="status-badge badge-held">--</span></dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">@L["Service"]</dt>
                            <dd class="col-sm-8">--</dd>
                            <dt class="col-sm-4">@L["CreatedAt"]</dt>
                            <dd class="col-sm-8">--</dd>
                            <dt class="col-sm-4">@L["Provider"]</dt>
                            <dd class="col-sm-8">--</dd>
                            <dt class="col-sm-4">@L["Reference"]</dt>
                            <dd class="col-sm-8"><code class="txn-ref">--</code></dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mb-4">
            <button class="btn btn-success" disabled>@L["ReleaseFunds"]</button>
            <button class="btn btn-outline-warning" disabled>@L["RaiseDispute"]</button>
            <button class="btn btn-outline-danger" disabled>@L["CancelHold"]</button>
        </div>

        <div class="dash-panel" data-reveal>
            <div class="dash-panel-header">
                <span class="panel-title">@L["Timeline"]</span>
            </div>
            <div class="dash-panel-body">
                <ol class="lifecycle-strip">
                    <li class="lifecycle-step is-complete">
                        <span class="lifecycle-dot"><i class="bi bi-check-lg" aria-hidden="true"></i></span>
                        <span class="lifecycle-label">@L["Created"]</span>
                    </li>
                    <li class="lifecycle-step is-active">
                        <span class="lifecycle-dot"><i class="bi bi-lock" aria-hidden="true"></i></span>
                        <span class="lifecycle-label">@L["Held"]</span>
                    </li>
                    <li class="lifecycle-step">
                        <span class="lifecycle-dot"><i class="bi bi-flag" aria-hidden="true"></i></span>
                        <span class="lifecycle-label">@L["Released"]</span>
                    </li>
                </ol>
                <div class="alert alert-secondary mb-0">
                    @L["TimelineComingSoon"]
                </div>
            </div>
        </div>
    }
</div>
