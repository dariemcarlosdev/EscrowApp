@page "/dashboard/client"
@layout DashboardLayout
@using Microsoft.AspNetCore.Authorization
@using EscrowApp.Components.Layout
@attribute [Authorize]
@attribute [StreamRendering]
@using Microsoft.Extensions.Localization

@* ── Page header ──────────────────────────────────────────────────────── *@
<div class="dash-page-header mb-4">
    <div>
        <h1 class="page-title">@L["PageTitle"]</h1>
        <p class="page-subtitle">@L["PageSubtitle"]</p>
    </div>
    <button class="btn-primary-dash" @onclick="HandleNewEscrow">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> @L["NewEscrow"]
    </button>
</div>

@if (_isLoading)
{
    <div class="dash-loader">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]</span>
        </div>
    </div>
}
else
{
    @* ── KPI cards ─────────────────────────────────────────────────────── *@
    <div class="kpi-grid mb-4">
        <div class="kpi-card kpi-blue">
            <span class="kpi-label">@L["ActiveHolds"]</span>
            <span class="kpi-value">@_heldCount</span>
            <span class="kpi-icon"><i class="bi bi-lock" aria-hidden="true"></i></span>
        </div>
        <div class="kpi-card kpi-green">
            <span class="kpi-label">@L["Released"]</span>
            <span class="kpi-value">@_releasedCount</span>
            <span class="kpi-icon"><i class="bi bi-check-circle" aria-hidden="true"></i></span>
        </div>
        <div class="kpi-card kpi-amber">
            <span class="kpi-label">@L["Disputed"]</span>
            <span class="kpi-value">@_disputedCount</span>
            <span class="kpi-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
        </div>
        <div class="kpi-card kpi-purple">
            <span class="kpi-label">@L["TotalEscrowed"]</span>
            <span class="kpi-value kpi-currency">$@_totalAmount.ToString("N2")</span>
            <span class="kpi-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
        </div>
    </div>

    @* ── Transactions panel ─────────────────────────────────────────────── *@
    <div class="dash-panel" data-reveal>
        <div class="dash-panel-header">
            <span class="panel-title">@L["TransactionsTitle"]</span>
            <div class="panel-header-actions">
                <span class="status-badge badge-all">All</span>
            </div>
        </div>
        <div class="dash-panel-body">
            @if (!_hasTransactions)
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-inbox" aria-hidden="true"></i>
                    </div>
                    <p class="empty-title">No transactions yet</p>
                    <p class="empty-sub">@L["NoTransactionsYet"]</p>
                    <button class="btn-primary-dash mt-3" @onclick="HandleNewEscrow">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> @L["NewEscrow"]
                    </button>
                </div>
            }
            else
            {
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Consultant</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Populated when data layer is wired *@
                    </tbody>
                </table>
            }
        </div>
    </div>
}
