@page "/dashboard/client"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [StreamRendering]
@using Microsoft.Extensions.Localization

<!-- TODO: Implement Client Dashboard UI
     This page shows the CLIENT (payer) their active escrow transactions.
     Key features:
     - List of transactions where the user is the payer (ClientEmail match)
     - Status indicators: Pending, Held, Released, Disputed, Cancelled
     - Actions: View Details, Dispute, Cancel (if Held)
     - Payment initiation for new escrows
-->

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="fw-bold">@L["PageTitle"]</h1>
            <p class="text-muted">@L["PageSubtitle"]</p>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@L["Loading"]</span>
            </div>
        </div>
    }
    else
    {
        <!-- TODO: Transaction summary cards (total held, total released, active disputes) -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h5 class="card-title text-primary">@L["ActiveHolds"]</h5>
                        <p class="display-6 fw-bold">--</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h5 class="card-title text-success">@L["Released"]</h5>
                        <p class="display-6 fw-bold">--</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h5 class="card-title text-warning">@L["Disputed"]</h5>
                        <p class="display-6 fw-bold">--</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-secondary">
                    <div class="card-body text-center">
                        <h5 class="card-title text-secondary">@L["TotalEscrowed"]</h5>
                        <p class="display-6 fw-bold">$--</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- TODO: Transaction table with filtering and pagination -->
        <div class="card">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span>@L["TransactionsTitle"]</span>
                <button class="btn btn-sm btn-outline-light">@L["NewEscrow"]</button>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    @L["NoTransactionsYet"]
                </div>
            </div>
        </div>
    }
</div>
