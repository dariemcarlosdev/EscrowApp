@page "/dashboard/consultant"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [StreamRendering]
@using Microsoft.Extensions.Localization

<!-- TODO: Implement Consultant Dashboard UI
     This page shows the CONSULTANT (payee) their escrow transactions.
     Key features:
     - List of transactions where the user is the consultant (ConsultantEmail match)
     - "Funds Secured" indicator showing held amounts
     - Actions: View Details, Mark Delivered, Request Release
     - Earnings summary (released funds)
-->

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="fw-bold">@L["PageTitle"]</h1>
            <p class="text-muted">@L["PageSubtitle"]</p>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@L["Loading"]</span>
            </div>
        </div>
    }
    else
    {
        <!-- TODO: Earnings summary cards -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h5 class="card-title text-success">@L["FundsSecured"]</h5>
                        <p class="display-6 fw-bold">$--</p>
                        <small class="text-muted">@L["FundsSecuredDesc"]</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h5 class="card-title text-primary">@L["TotalEarned"]</h5>
                        <p class="display-6 fw-bold">$--</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h5 class="card-title text-warning">@L["PendingDelivery"]</h5>
                        <p class="display-6 fw-bold">--</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- TODO: Active engagements table -->
        <div class="card">
            <div class="card-header bg-dark text-white">
                @L["ActiveEngagements"]
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    @L["NoEngagementsYet"]
                </div>
            </div>
        </div>
    }
</div>
