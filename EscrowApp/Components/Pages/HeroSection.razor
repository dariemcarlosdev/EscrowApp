@* HeroSection — Headline, waitlist CTA form, and escrow simulation card *@

<div class="container min-vh-100 d-flex flex-column justify-content-center pt-5">
    <div class="row align-items-center mb-5 mt-5">
        <div class="col-lg-6 text-center text-lg-start mb-5 mb-lg-0">
            <h1 class="display-3 fw-bold mb-3">
                @L["HeroTitle1"] <br />
                <span class="text-gradient">@L["HeroTitle2"]</span>
            </h1>
            <p class="lead text-secondary mb-4">
                @L["HeroSubtitle"]
            </p>

            <div class="mt-4">
                <form @onsubmit="HandleWaitlistSubmit" @onsubmit:preventDefault class="d-flex flex-column flex-sm-row gap-2 justify-content-center justify-content-lg-start">
                    <input type="email"
                           @bind="WaitlistEmail"
                           class="form-control form-control-glass px-4 py-3 bg-dark waitlist-input"
                           placeholder="@L["EmailPlaceholder"]"
                           disabled="@IsSubmitting"
                           required />
                    <button type="submit" class="btn btn-glass px-5 py-3 fs-6" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        @L["JoinWaitlist"]
                    </button>
                </form>

                @if (SubmitSuccess)
                {
                    <div class="alert alert-success alert-glass mt-3 py-2 px-3 d-inline-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
                        @L["SubmitSuccess"]
                    </div>
                }
                else if (SubmitError)
                {
                    <div class="alert alert-danger alert-glass mt-3 py-2 px-3 d-inline-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
                        @L["SubmitError"]
                    </div>
                }
                else
                {
                    <p class="text-secondary small mt-3 text-center text-lg-start">
                        <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                        @L["NoSpam"]
                    </p>
                }
            </div>
        </div>

        <div class="col-lg-6 mt-lg-0 mt-5 pt-lg-0 pt-4">
            <div class="glass-panel text-center p-5 mx-auto hero-card @(FundsReleased ? "card-released" : "") animate-enter">
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="var(--accent-blue)" class="bi bi-shield-lock-fill mb-3" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5z"/>
                    </svg>
                    <h3 class="fw-bold m-0">@L["ActiveGuarantee"]</h3>
                    <p class="text-secondary mt-1">@L["DepositDescription"]</p>
                </div>

                <h2 class="display-3 fw-bold text-white mb-4">$500.00</h2>

                <div class="d-flex justify-content-between align-items-center rounded p-3 mb-4 status-row">
                    <span class="text-secondary small fw-bold text-uppercase">@L["CurrentStatus"]</span>
                    @if (FundsReleased)
                    {
                        <span class="badge bg-info bg-opacity-25 text-info border border-info rounded-pill px-3 py-2">
                            @L["FundsReleased"]
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-3 py-2">
                            @L["FundsSecured"]
                        </span>
                    }
                </div>

                <button class="btn @(FundsReleased ? "btn-outline-secondary disabled" : "btn-outline-success") w-100 rounded-pill py-2"
                        @onclick="SimulateRelease"
                        disabled="@FundsReleased">
                    @if (FundsReleased)
                    {
                        <span>✅ @L["TransactionComplete"]</span>
                    }
                    else
                    {
                        <span>✅ @L["ReleaseFunds"]</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="text-center scroll-hint">
        <a href="#como-funciona" class="text-secondary" aria-label="@L["ScrollToLearnMore"]">
            <i class="bi bi-chevron-double-down fs-3 bounce-animation" aria-hidden="true"></i>
        </a>
    </div>
</div>
