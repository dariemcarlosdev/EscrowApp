@* HeroSection — Eyebrow, editorial headline, waitlist CTA, factual trust row,
   and a Protection Receipt artifact that advances Deposited → Held → Released. *@

<section class="hero-section">
    <div class="hero-guilloche" aria-hidden="true"></div>

    <div class="container hero-inner">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 text-center text-lg-start hero-copy">
                <span class="hero-eyebrow">
                    <span class="eyebrow-dot" aria-hidden="true"></span>@L["Eyebrow"]
                </span>

                <h1 class="hero-headline">
                    @L["HeroTitle1"] <br />
                    <span class="hero-accent">@L["HeroTitle2"]</span>
                </h1>

                <p class="hero-sub">@L["HeroSubtitle"]</p>

                <form @onsubmit="HandleWaitlistSubmit" @onsubmit:preventDefault
                      class="hero-form d-flex flex-column flex-sm-row gap-2 justify-content-center justify-content-lg-start">
                    <input type="email"
                           @bind="WaitlistEmail"
                           class="waitlist-input"
                           placeholder="@L["EmailPlaceholder"]"
                           autocomplete="email"
                           disabled="@IsSubmitting"
                           required />
                    <button type="submit" class="btn btn-glass px-4" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        @L["JoinWaitlist"]
                    </button>
                </form>

                <div class="hero-feedback" aria-live="polite">
                    @if (SubmitSuccess)
                    {
                        <div class="alert alert-success alert-glass py-2 px-3 d-inline-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
                            @L["SubmitSuccess"]
                        </div>
                    }
                    else if (SubmitError)
                    {
                        <div class="alert alert-danger alert-glass py-2 px-3 d-inline-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
                            @L["SubmitError"]
                        </div>
                    }
                    else
                    {
                        <p class="hero-nospam">
                            <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                            @L["NoSpam"]
                        </p>
                    }
                </div>

                <ul class="trust-row">
                    <li><i class="bi bi-bank2" aria-hidden="true"></i>@L["TrustProcessor"]</li>
                    <li><i class="bi bi-credit-card-2-front" aria-hidden="true"></i>@L["TrustNoCard"]</li>
                    <li><i class="bi bi-patch-check" aria-hidden="true"></i>@L["TrustApproval"]</li>
                </ul>
            </div>

            <div class="col-lg-6">
                <div class="receipt mx-auto @(FundsReleased ? "is-released" : "")">
                    <div class="receipt-head">
                        <div class="receipt-badge">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5z"/>
                            </svg>
                            @L["ActiveGuarantee"]
                        </div>
                        <span class="receipt-ref">NX-2026-0500</span>
                    </div>

                    <p class="receipt-desc">@L["DepositDescription"]</p>
                    <div class="receipt-amount">$500<span class="receipt-cents">.00</span></div>

                    <div class="track" role="list" aria-label="@L["CurrentStatus"]">
                        <div class="track-step is-done" role="listitem">
                            <span class="track-dot"></span>
                            <span class="track-label">@L["StepDeposited"]</span>
                        </div>
                        <div class="track-step @(FundsReleased ? "is-done" : "is-current")" role="listitem">
                            <span class="track-dot"></span>
                            <span class="track-label">@L["StepHeld"]</span>
                        </div>
                        <div class="track-step @(FundsReleased ? "is-current" : "")" role="listitem">
                            <span class="track-dot"></span>
                            <span class="track-label">@L["StepReleased"]</span>
                        </div>
                    </div>

                    <button class="receipt-action @(FundsReleased ? "is-complete" : "")"
                            @onclick="SimulateRelease"
                            disabled="@FundsReleased">
                        @if (FundsReleased)
                        {
                            <span><i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> @L["TransactionComplete"]</span>
                        }
                        else
                        {
                            <span><i class="bi bi-arrow-right-circle me-1" aria-hidden="true"></i> @L["ReleaseFunds"]</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <div class="scroll-hint text-center">
            <a href="#como-funciona" aria-label="@L["ScrollToLearnMore"]">
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>
