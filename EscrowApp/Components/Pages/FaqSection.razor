@* FaqSection — Collapsible FAQ using native HTML details/summary *@

<div class="container py-5 my-5">
    <div class="row text-center mb-5">
        <h2 class="display-5 fw-bold mb-3">@L["Title"]</h2>
        <p class="text-secondary mx-auto section-subtitle">
            @L["Subtitle"]
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <details class="faq-item glass-panel mb-3">
                <summary class="fw-bold text-white">@L["Faq1Q"]</summary>
                <p class="text-secondary mt-3 mb-0">@L["Faq1A"]</p>
            </details>

            <details class="faq-item glass-panel mb-3">
                <summary class="fw-bold text-white">@L["Faq2Q"]</summary>
                <p class="text-secondary mt-3 mb-0">@L["Faq2A"]</p>
            </details>

            <details class="faq-item glass-panel mb-3">
                <summary class="fw-bold text-white">@L["Faq3Q"]</summary>
                <p class="text-secondary mt-3 mb-0">@L["Faq3A"]</p>
            </details>

            <details class="faq-item glass-panel mb-3">
                <summary class="fw-bold text-white">@L["Faq4Q"]</summary>
                <p class="text-secondary mt-3 mb-0">@L["Faq4A"]</p>
            </details>

            <details class="faq-item glass-panel mb-3">
                <summary class="fw-bold text-white">@L["Faq5Q"]</summary>
                <p class="text-secondary mt-3 mb-0">@L["Faq5A"]</p>
            </details>
        </div>
    </div>
</div>
