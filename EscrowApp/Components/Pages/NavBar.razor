@* NavBar — Brand, language toggle, authentication controls, and navigation links *@
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<nav class="navbar navbar-expand-lg fixed-top nav-shell" data-nav-shell>
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <svg class="brand-mark" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 16 16" aria-hidden="true">
                <path fill-rule="evenodd" fill="var(--accent-blue)" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5z"/>
            </svg>
            <span class="brand-wordmark">NexTruzt<span class="brand-tld">.io</span></span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <a class="nav-link nav-anchor px-3" href="#como-funciona">@L["HowItWorks"]</a>
                <a class="nav-link nav-anchor px-3" href="#faq">@L["Faq"]</a>

                <button class="btn btn-sm lang-toggle ms-lg-2"
                        aria-label="@L["LanguageToggleAriaLabel"]"
                        @onclick="SwitchCulture">
                    <i class="bi bi-globe2" aria-hidden="true"></i> @L["LanguageToggleText"]
                </button>

                @* Authentication controls — CascadingAuthenticationState is required here
                   because NavBar is used inside @rendermode InteractiveServer components
                   where the outer Routes.razor cascade does not cross the render-mode boundary. *@
                <CascadingAuthenticationState>
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown ms-lg-2 mt-3 mt-lg-0">
                            <button class="btn btn-sm btn-account dropdown-toggle"
                                    type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1" aria-hidden="true"></i>@context.User.Identity?.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-lg-end" aria-labelledby="userMenuDropdown">
                                <li><a class="dropdown-item" href="/dashboard/client">@L["Dashboard"]</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @* POST to /auth/logout — must be a real HTTP POST so the server
                                       can write the cookie-deletion header over a proper HTTP response.
                                       NavigateTo("/auth/logout") inside a Blazor circuit issues a GET
                                       and the auth cookie is never cleared. *@
                                    <form method="post" action="/auth/logout">
                                        <AntiforgeryToken />
                                        <button type="submit" class="dropdown-item">
                                            @L["Logout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink class="btn btn-sm btn-signin ms-lg-2 mt-3 mt-lg-0" href="/auth/login">@L["LogIn"]</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
                </CascadingAuthenticationState>
            </div>
        </div>
    </div>
</nav>
