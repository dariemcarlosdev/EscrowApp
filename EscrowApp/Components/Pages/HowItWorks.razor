@* HowItWorks — 3-step workflow cards with visual connectors *@

<div id="como-funciona" class="container py-5 my-5">
    <div class="row text-center mb-5 pb-3">
        <h2 class="display-5 fw-bold mb-3">@L["Title"]</h2>
        <p class="text-secondary mx-auto section-subtitle">
            @L["Subtitle"]
        </p>
    </div>

    <div class="row g-4 position-relative">
        <div class="step-connector d-none d-md-block" aria-hidden="true"></div>

        <div class="col-md-4">
            <div class="glass-panel h-100 text-center p-5">
                <div class="step-number text-gradient fw-bold mb-4">1</div>
                <h4 class="fw-bold how-step-title mb-3">@L["Step1Title"]</h4>
                <p class="text-secondary">@L["Step1Desc"]</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel h-100 text-center p-5 card-elevated">
                <div class="step-number text-gradient fw-bold mb-4">2</div>
                <h4 class="fw-bold how-step-title mb-3">@L["Step2Title"]</h4>
                <p class="text-secondary">@L["Step2Desc"]</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel h-100 text-center p-5">
                <div class="step-number text-gradient fw-bold mb-4">3</div>
                <h4 class="fw-bold how-step-title mb-3">@L["Step3Title"]</h4>
                <p class="text-secondary">@L["Step3Desc"]</p>
            </div>
        </div>
    </div>
</div>
