@* HowItWorks — 3-step workflow cards with visual connectors *@

<div id="como-funciona" class="container py-5 my-5">
    <div class="row text-center mb-5 pb-3" data-reveal>
        <h2 class="display-5 fw-bold mb-3">@L["Title"]</h2>
        <p class="text-secondary mx-auto section-subtitle">
            @L["Subtitle"]
        </p>
    </div>

    <div class="row g-4 position-relative" data-reveal-stagger>
        <div class="step-connector d-none d-md-block" aria-hidden="true"></div>

        <div class="col-md-4">
            <div class="glass-panel h-100 p-5 step-card">
                <div class="step-number fw-bold mb-4">01</div>
                <h4 class="fw-bold how-step-title mb-3">@L["Step1Title"]</h4>
                <p class="text-secondary mb-0">@L["Step1Desc"]</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel h-100 p-5 step-card card-elevated">
                <div class="step-number fw-bold mb-4">02</div>
                <h4 class="fw-bold how-step-title mb-3">@L["Step2Title"]</h4>
                <p class="text-secondary mb-0">@L["Step2Desc"]</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel h-100 p-5 step-card">
                <div class="step-number fw-bold mb-4">03</div>
                <h4 class="fw-bold how-step-title mb-3">@L["Step3Title"]</h4>
                <p class="text-secondary mb-0">@L["Step3Desc"]</p>
            </div>
        </div>
    </div>
</div>
