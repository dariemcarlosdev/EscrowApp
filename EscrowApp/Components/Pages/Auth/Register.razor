@page "/auth/register"
@using Microsoft.Extensions.Localization

<!-- TODO: Implement registration page
     Collect: Email, Password, Role (Client or Consultant), Display Name
     For MVP: ASP.NET Core Identity registration
     For Production: Entra ID self-service signup or invite-only
-->

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4">@L["RegisterTitle"]</h2>

                    <div class="alert alert-info">
                        Registration not yet configured. See docs/05-Hybrid-Identity for setup.
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" disabled>@L["CreateAccount"]</button>
                    </div>

                    <hr />
                    <p class="text-center text-muted">
                        @L["HasAccount"] <a href="/auth/login">@L["SignIn"]</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
